# Optional. Every LLM-backed step (trial-criteria extraction, PDF/OCR
# cleaning, and the Research Assistant's synthesis) resolves a provider in
# this order and never errors — it just falls through to the next one:
#
#   1. Ollama, if running locally with OLLAMA_MODEL pulled (default: gpt-oss:20b)
#   2. Groq API, if GROQ_API_KEY is set and Ollama isn't reachable
#   3. LM Studio (legacy local fallback), if neither of the above is available
#   4. Extractive summary / pre-baked fallback data (always available, no setup)
#
# So: if you have Ollama running locally with gpt-oss:20b pulled, none of
# this needs to be touched — it's picked up automatically. If you don't
# (e.g. a friend cloning this without Ollama installed), just set
# GROQ_API_KEY below and everything runs the same way, no local model needed.
#
# Structured lab-stat questions (e.g. "average HbA1c") always answer by
# direct computation over the dataset, regardless of which provider is used.

# --- Ollama (local, no key needed) -----------------------------------------
# Install: https://ollama.com  |  Pull the model: `ollama pull gpt-oss:20b`
# Then just run `ollama serve` (or let the app launch it) — no env vars
# required unless you're running Ollama on a non-default host/port or model.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gpt-oss:20b

# --- Groq (cloud, free tier available, used if Ollama isn't reachable) -----
# Get a key: https://console.groq.com/keys
GROQ_API_KEY=gsk_...
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# --- LM Studio (legacy local fallback, used only if neither of the above is
# available) ------------------------------------------------------------
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=lm-studio
LLM_MODEL=google/gemma-4-e4b

# Force a specific backend instead of auto-detecting (ollama|groq|lm_studio):
# LLM_PROVIDER=groq
