# Optional. The Research Assistant's LLM synthesis step tries providers in
# this order and never errors — it just falls through to the next one:
#
#   1. Ollama, if running locally with OLLAMA_MODEL pulled (default: gpt-oss:20b)
#   2. Anthropic API, if ANTHROPIC_API_KEY is set
#   3. Extractive summary of retrieved evidence (always available, no setup)
#
# Structured lab-stat questions (e.g. "average HbA1c") always answer by
# direct computation over the dataset, regardless of which provider is used.

# --- Ollama (local, no key needed) -----------------------------------------
# Install: https://ollama.com  |  Pull the model: `ollama pull gpt-oss:20b`
# Then just run `ollama serve` (or let the app launch it) — no env vars
# required unless you're running Ollama on a non-default host/port or model.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gpt-oss:20b

# --- Anthropic (cloud, used if Ollama isn't reachable) ----------------------
ANTHROPIC_API_KEY=sk-ant-...
