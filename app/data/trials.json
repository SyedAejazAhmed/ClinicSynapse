[
  {
    "id": "T101",
    "title": "DIAB-2027: Study of Investigational Therapy in Type 2 Diabetes",
    "phase": "Phase 3",
    "condition": [
      "Type 2 diabetes mellitus"
    ],
    "intervention": [
      "Investigational Diabetes Agent A"
    ],
    "eligibility": {
      "inclusion": [
        {
          "id": "INC-1",
          "category": "demographics",
          "text": "Age 18 to 65 years, inclusive.",
          "structured": {
            "type": "age_range",
            "min": 18,
            "max": 65
          }
        },
        {
          "id": "INC-2",
          "category": "diagnosis",
          "text": "Diagnosis of Type 2 diabetes mellitus at least 6 months prior to screening.",
          "structured": {
            "type": "diagnosis_required",
            "codes": [
              "E11.9"
            ],
            "systems": [
              "ICD-10"
            ],
            "min_duration_months": 6
          }
        },
        {
          "id": "INC-3",
          "category": "lab",
          "text": "HbA1c ≥ 7.0% at screening.",
          "structured": {
            "type": "lab_threshold",
            "code": "4548-4",
            "display": "Hemoglobin A1c",
            "operator": ">=",
            "value": 7.0,
            "unit": "%"
          }
        },
        {
          "id": "INC-4",
          "category": "lab",
          "text": "eGFR ≥ 60 mL/min/1.73m².",
          "structured": {
            "type": "lab_threshold",
            "code": "33914-3",
            "display": "Glomerular filtration rate/1.73 sq M.predicted",
            "operator": ">=",
            "value": 60,
            "unit": "mL/min/1.73m2"
          }
        },
        {
          "id": "INC-5",
          "category": "medication",
          "text": "On stable metformin therapy for at least 3 months.",
          "structured": {
            "type": "medication_required",
            "codes": [
              "860975"
            ],
            "systems": [
              "RxNorm"
            ],
            "min_duration_months": 3
          }
        }
      ],
      "exclusion": [
        {
          "id": "EXC-1",
          "category": "lab",
          "text": "eGFR < 45 mL/min/1.73m².",
          "structured": {
            "type": "lab_threshold",
            "code": "33914-3",
            "display": "Glomerular filtration rate/1.73 sq M.predicted",
            "operator": "<",
            "value": 45,
            "unit": "mL/min/1.73m2"
          }
        },
        {
          "id": "EXC-2",
          "category": "condition",
          "text": "History of severe renal disease requiring dialysis.",
          "structured": {
            "type": "condition_forbidden",
            "keywords": [
              "dialysis",
              "severe renal disease"
            ],
            "systems": [
              "ICD-10"
            ]
          }
        },
        {
          "id": "EXC-3",
          "category": "social_history",
          "text": "Current smoker.",
          "structured": {
            "type": "smoking_forbidden",
            "forbidden_statuses": [
              "Current smoker"
            ]
          }
        }
      ]
    },
    "consent_required": true,
    "source": {
      "clinicaltrials_gov_id": "NCT10000101",
      "protocol_pdf_url": "trials/T101-protocol.pdf"
    },
    "status": "RECRUITING",
    "sponsor": "ICMR / AIIMS Delhi",
    "locations": [
      "Delhi",
      "Tamil Nadu",
      "Karnataka"
    ],
    "start_date": "2026-01-15"
  },
